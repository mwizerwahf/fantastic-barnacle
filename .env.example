# Copy to .env and fill in. Never commit .env.

# --- Broker (Alpaca) -----------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# paper (default) | live. Live ALSO requires CONFIRM_LIVE_TRADING=yes.
TRADING_MODE=paper
CONFIRM_LIVE_TRADING=no

# --- Market data ---------------------------------------------------------------
DATA_FEED=iex                     # iex (free) | sip (paid subscription)
SYMBOLS=SPY,QQQ
TIMEFRAME_MINUTES=5               # 1 | 5 | 15
CVD_SOURCE=trades                 # trades (tick-rule on prints) | bars (cruder proxy)
CVD_LOOKBACK_MINUTES=60

# --- AI (LiteLLM model strings; swap provider by changing only this) ---------------
AI_MODEL=anthropic/claude-sonnet-5-5
# Comma-separated fallback chain, tried on provider/transport failure. Check each
# provider's docs for current model names, e.g. openai/<model>, gemini/<model>, ollama/llama3.1
AI_FALLBACK_MODELS=
# Server URL for self-hosted models (ollama/, ollama_chat/, hosted_vllm/, lm_studio/ only).
# Example Ollama fallback: AI_FALLBACK_MODELS=ollama/llama3.1 and AI_API_BASE=http://localhost:11434
# AI_API_BASE=http://localhost:11434
AI_TIMEOUT_S=30
# Output token cap. Keep it high for "thinking" models (Gemini 3.x etc.): their
# reasoning counts against it, and a low cap cuts the JSON off -> HOLD.
AI_MAX_TOKENS=4000

# Provider keys read by LiteLLM (only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Strategy ------------------------------------------------------------------
STRATEGY=intraday_momentum

# --- Risk (clamped to hard limits in risk/guardrails.py) --------------------------
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_NOTIONAL_PCT=0.25
MIN_REWARD_RISK=1.5
MIN_CONFIDENCE=0.6
MIN_STOP_ATR_MULT=0.5
MAX_DAILY_DRAWDOWN_PCT=0.03
EOD_FLATTEN_MINUTES=15
MAX_CONCURRENT_POSITIONS=2
MAX_TRADES_PER_DAY=6
OPEN_BLACKOUT_MINUTES=5
ALLOW_SHORT=false
PDT_EQUITY_THRESHOLD=25000
PDT_MAX_DAY_TRADES=3

# --- Runtime -----------------------------------------------------------------------
STATE_DIR=state
FLATTEN_ON_SHUTDOWN=true
LOG_LEVEL=INFO
LOG_JSON=true

# =================================================================================
# Forex engine (python -m fx ...). Strategies, accounts and AI models are managed in
# the FX console; only machine-level settings live here.
# =================================================================================
# Encrypts OANDA tokens and AI keys stored in SQLite. Generate: python -m fx keygen
# Back it up: without it, stored keys cannot be decrypted (you would re-enter them).
FX_MASTER_KEY=
# Live OANDA accounts are never traded unless this is true (practice accounts always work).
FX_ALLOW_LIVE=false
FX_DB_PATH=fx_state/fx.db
FX_DASHBOARD_PORT=8060
FX_LOG_LEVEL=INFO
# Provider keys for AI models whose console entry leaves "API key" empty:
# GEMINI_API_KEY=   ANTHROPIC_API_KEY=   OPENAI_API_KEY=
