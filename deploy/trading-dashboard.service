[Unit]
Description=Read-only trading dashboard (served by nginx at /tdpltfm/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading_bot
ExecStart=/opt/trading_bot/.venv/bin/python -m dashboard.app
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# SQLite needs write access to the journal's -shm file even for read-only access.
ReadWritePaths=/opt/trading_bot/state

[Install]
WantedBy=multi-user.target
